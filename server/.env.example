NODE_ENV=production
# PORT is auto-set by Railway — do NOT set manually
CLIENT_URL=https://your-app.vercel.app
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=28164
DB_NAME=defaultdb
DB_USER=avnadmin
